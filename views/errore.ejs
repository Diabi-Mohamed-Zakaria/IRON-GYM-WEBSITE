<%- include('partials/header') %>

<section class="error-page">
    <div class="container">
        <div class="error-card">
            <div class="error-code">
                <%= code || 500 %>
            </div>
            <h1 class="error-title">
                <% if (code === 404) { %>
                    Pagina Non Trovata
                <% } else if (code === 403) { %>
                    Accesso Negato
                <% } else if (code === 401) { %>
                    Non Autorizzato
                <% } else { %>
                    Errore del Server
                <% } %>
            </h1>
            <p class="error-message">
                <%= message || 'Si è verificato un errore imprevisto.' %>
            </p>
            <div class="error-actions">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house"></i> Torna alla Home
                </a>
                <% if (user) { %>
                    <a href="/dashboard" class="btn btn-secondary">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn-secondary">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</section>

<style>
.error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
}

.error-card {
    text-align: center;
    max-width: 500px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 3rem 2rem;
}

.error-code {
    font-size: 4rem;
    font-weight: bold;
    color: var(--primary);
    margin-bottom: 1rem;
}

.error-title {
    font-size: 2rem;
    color: var(--text);
    margin-bottom: 1rem;
}

.error-message {
    color: var(--muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
    line-height: 1.6;
}

.error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.error-actions .btn {
    min-width: 150px;
}
</style>

<%- include('partials/footer') %>
