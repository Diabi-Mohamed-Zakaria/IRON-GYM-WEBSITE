<%- include('partials/header') %>

<section class="py-5">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2>Payment <span class="gold-gradient">Status</span></h2>
          <a href="/client/dashboard" class="btn btn-outline-warning">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
          </a>
        </div>
        <div class="gold-line"></div>
      </div>
    </div>

    <!-- Current Membership Status -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card feature-card">
          <div class="card-body">
            <h4 class="text-warning mb-3">
              <i class="bi bi-credit-card"></i> Current Membership
            </h4>
            <div id="membership-status">
              <div class="text-center py-4">
                <div class="spinner-border text-warning" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-secondary">Loading membership information...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment History -->
    <div class="row">
      <div class="col-12">
        <div class="card feature-card">
          <div class="card-body">
            <h4 class="text-warning mb-3">
              <i class="bi bi-clock-history"></i> Payment History
            </h4>
            <div id="payment-history">
              <div class="text-center py-4">
                <div class="spinner-border text-warning" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-secondary">Loading payment history...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
