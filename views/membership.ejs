<%- include('partials/header') %>

<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2>Choose your <span class="gold-gradient">Membership</span></h2>
      <div class="gold-line"></div>
      <p class="text-secondary mt-2">Select a plan to unlock booking and perks.</p>
      
      <!-- Billing Period Toggle -->
      <div class="billing-toggle mb-4">
        <div class="btn-group" role="group">
          <input type="radio" class="btn-check" name="billingPeriod" id="monthly" value="monthly" checked>
          <label class="btn btn-outline-warning" for="monthly">Monthly</label>
          
          <input type="radio" class="btn-check" name="billingPeriod" id="annual" value="annual">
          <label class="btn btn-outline-warning" for="annual">Annual <span class="badge bg-success">Save 20%</span></label>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Basic Plan -->
      <div class="col-md-4">
        <div class="card feature-card h-100">
          <div class="card-body text-center">
            <h3 class="text-warning">BASIC</h3>
            <div class="price-display mb-3">
              <span class="h2" id="basic-price">€29.99</span>
              <span class="text-secondary" id="basic-period">/month</span>
            </div>
            <ul class="list-unstyled mb-4">
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Gym Access</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Basic Equipment</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Locker Room</li>
            </ul>
            <div class="payment-options">
              <button class="btn btn-outline-warning w-100 mb-2" data-plan="basic" data-method="cash">
                <i class="bi bi-cash"></i> Pay in Gym
              </button>
              <button class="btn btn-warning w-100" data-plan="basic" data-method="card">
                <i class="bi bi-credit-card"></i> Pay with Card
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Premium Plan -->
      <div class="col-md-4">
        <div class="card feature-card h-100 border-warning">
          <div class="card-body text-center">
            <div class="badge bg-warning text-dark mb-2">MOST POPULAR</div>
            <h3 class="text-warning">PREMIUM</h3>
            <div class="price-display mb-3">
              <span class="h2" id="premium-price">€49.99</span>
              <span class="text-secondary" id="premium-period">/month</span>
            </div>
            <ul class="list-unstyled mb-4">
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Gym Access</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> All Equipment</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Group Classes</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Locker Room</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Shower</li>
            </ul>
            <div class="payment-options">
              <button class="btn btn-outline-warning w-100 mb-2" data-plan="premium" data-method="cash">
                <i class="bi bi-cash"></i> Pay in Gym
              </button>
              <button class="btn btn-warning w-100" data-plan="premium" data-method="card">
                <i class="bi bi-credit-card"></i> Pay with Card
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Elite Plan -->
      <div class="col-md-4">
        <div class="card feature-card h-100">
          <div class="card-body text-center">
            <h3 class="text-warning">ELITE</h3>
            <div class="price-display mb-3">
              <span class="h2" id="elite-price">€79.99</span>
              <span class="text-secondary" id="elite-period">/month</span>
            </div>
            <ul class="list-unstyled mb-4">
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Gym Access</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> All Equipment</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Unlimited Classes</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Personal Trainer Sessions</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Spa Access</li>
              <li class="mb-2 text-white"><i class="bi bi-check-circle text-success"></i> Nutrition Consultation</li>
            </ul>
            <div class="payment-options">
              <button class="btn btn-outline-warning w-100 mb-2" data-plan="elite" data-method="cash">
                <i class="bi bi-cash"></i> Pay in Gym
              </button>
              <button class="btn btn-warning w-100" data-plan="elite" data-method="card">
                <i class="bi bi-credit-card"></i> Pay with Card
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- Card Payment Modal -->
<div class="modal fade" id="cardPaymentModal" tabindex="-1" aria-labelledby="cardPaymentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="cardPaymentModalLabel">
          <i class="bi bi-credit-card text-warning"></i> Card Payment
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <h6>Plan: <span class="text-warning" id="modal-plan-type"></span></h6>
          <h6>Billing: <span class="text-warning" id="modal-billing-period"></span></h6>
          <h6>Amount: <span class="text-warning" id="modal-amount"></span></h6>
        </div>
        <form id="cardPaymentForm">
          <div class="mb-3">
            <label for="cardNumber" class="form-label">Card Number</label>
            <input type="text" class="form-control" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="expiryDate" class="form-label">Expiry Date</label>
              <input type="text" class="form-control" id="expiryDate" placeholder="MM/YY" maxlength="5" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="cvv" class="form-label">CVV</label>
              <input type="text" class="form-control" id="cvv" placeholder="123" maxlength="3" required>
            </div>
          </div>
          <div class="mb-3">
            <label for="cardholderName" class="form-label">Cardholder Name</label>
            <input type="text" class="form-control" id="cardholderName" placeholder="John Doe" required>
          </div>
          <div id="cardPaymentError" class="alert alert-danger d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" id="processCardPayment">
          <i class="bi bi-credit-card"></i> Process Payment
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
