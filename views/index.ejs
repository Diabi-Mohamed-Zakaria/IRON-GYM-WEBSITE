<%- include('partials/header') %>

<section class="hero-section hero-has-image hero-homepage">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">TRANSFORM YOUR BODY</h1>
            <p class="hero-subtitle">Join the elite. Experience premium fitness like never before.</p>
            <div class="hero-buttons">
                <% if (!user) { %>
                    <a href="/join" class="btn btn-primary btn-lg">JOIN NOW</a>
                    <a href="/classes" class="btn btn-outline-light btn-lg">VIEW CLASSES</a>
                <% } else { %>
                    <a href="/dashboard" class="btn btn-primary btn-lg">GO TO DASHBOARD</a>
                    <a href="/classes" class="btn btn-outline-light btn-lg">BOOK A CLASS</a>
                <% } %>
            </div>
        </div>
    </div>
    
    <!-- Scroll Arrow -->
    <div class="scroll-arrow" id="scroll-to-next-btn">
        <i class="bi bi-arrow-down"></i>
    </div>
</section>

<!-- About Us Section -->
<section class="py-5 bg-dark">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Side - Text Content -->
            <div class="col-lg-6">
                <div class="pe-lg-4">
                    <h2 class="text-white fw-bold mb-4">ABOUT <span class="gold-gradient">IRON GYM</span></h2>
                    <div class="gold-line mb-4"></div>
                    
                    <div class="text-light mb-4">
                        <p class="mb-3">Fitness is not just a hobby—it's a lifestyle that empowers you to become the best version of yourself. At IRON GYM, we believe that every individual has the potential to achieve extraordinary results.</p>
                        
                        <p class="mb-3">Our state-of-the-art facility is equipped with the latest fitness technology and staffed by expert trainers who are passionate about helping you reach your goals. From beginners to elite athletes, we provide personalized guidance and support.</p>
                        
                        <p class="mb-4">Whether you're looking to build strength, improve endurance, or simply maintain a healthy lifestyle, IRON GYM provides the perfect environment for growth, challenge, and transformation.</p>
                    </div>
                    
                    <!-- Statistics -->
                    <div class="row g-4 about-stats">
                        <div class="col-6">
                            <div class="text-center">
                                <h3 class="gold-gradient fw-bold mb-1">2,000+</h3>
                                <p class="text-light mb-0">Members</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h3 class="gold-gradient fw-bold mb-1">50+</h3>
                                <p class="text-light mb-0">Expert Trainers</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h3 class="gold-gradient fw-bold mb-1">100+</h3>
                                <p class="text-light mb-0">Weekly Classes</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h3 class="gold-gradient fw-bold mb-1">95%</h3>
                                <p class="text-light mb-0">Customer Satisfaction</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Right Side - Image with CTA -->
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="/images/Interno_della_palestra.jpg" alt="IRON GYM Interior" class="img-fluid rounded-3 shadow-lg about-us-image">
                    
                    <!-- CTA Overlay -->
                    <div class="position-absolute bottom-0 end-0 m-4">
                        <div class="about-cta-overlay text-dark p-4 rounded-3 shadow-lg about-cta-box">
                            <h4 class="fw-bold mb-2">START TODAY</h4>
                            <p class="mb-3 small">First month's half on us feel the IRON difference.</p>
                            <% if (!user) { %>
                                <a href="/join" class="btn btn-dark btn-sm">JOIN NOW</a>
                            <% } else { %>
                                <a href="/classes" class="btn btn-dark btn-sm">BOOK CLASS</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="features-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2>WHY CHOOSE <span class="gold-gradient">IRON GYM</span>?</h2>
            <div class="gold-line center"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <i class="bi bi-trophy-fill display-1 text-warning"></i>
                    <h3>Expert Trainers</h3>
                    <p>World-class certified trainers dedicated to your success</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <i class="bi bi-gear-fill display-1 text-warning"></i>
                    <h3>Premium Equipment</h3>
                    <p>State-of-the-art facilities and cutting-edge technology</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <i class="bi bi-people-fill display-1 text-warning"></i>
                    <h3>Community</h3>
                    <p>Join a motivated community of fitness enthusiasts</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card feature-card p-0 gallery-card">
                    <img src="/images/Interno_della_palestra.jpg" alt="Club" class="gallery-image">
                    <div class="p-3">
                        <h3 class="text-white">World-class Studios</h3>
                        <p class="text-white mb-0">Nightclub lights, premium sound and elite trainers.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card feature-card p-0 gallery-card">
                    <img src="/images/spa-sauna.jpg" alt="Studios" class="gallery-image">
                    <div class="p-3">
                        <h3 class="text-white">Recovery & Amenities</h3>
                        <p class="text-white mb-0">Lockers, showers, shakes and everything you need.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
 </section>

<!-- Reviews Section -->
<section class="py-5 bg-dark">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="text-white">WHAT OUR <span class="gold-gradient">MEMBERS</span> SAY</h2>
            <div class="gold-line mx-auto mt-2"></div>
            <p class="text-light mt-3">Real experiences from our community</p>
        </div>
        
        <!-- Reviews Grid -->
        <div class="row g-4">
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(function(review) { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card bg-dark border-secondary h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="card-title text-warning mb-1"><%= review.title %></h6>
                                        <div class="rating-display mb-2">
                                            <% 
                                            var stars = '';
                                            for (var i = 1; i <= 5; i++) {
                                                if (i <= review.rating) {
                                                    stars += '★';
                                                } else {
                                                    stars += '☆';
                                                }
                                            }
                                            %>
                                            <%= stars %>
                                        </div>
                                    </div>
                                    <small class="text-light">
                                        <%= new Date(review.created_at).toLocaleDateString('it-IT', { 
                                            year: 'numeric', 
                                            month: 'short', 
                                            day: 'numeric' 
                                        }) %>
                                    </small>
                                </div>
                                <p class="card-text text-light"><%= review.comment %></p>
                                <div class="mt-auto">
                                    <small class="text-light">
                                        <i class="bi bi-person"></i> <%= review.nome %> <%= review.cognome %>
                                        <% if (review.review_type === 'trainer' && review.trainer_nome) { %>
                                            <br><i class="bi bi-person-badge"></i> Trainer: <%= review.trainer_nome %> <%= review.trainer_cognome %>
                                        <% } else { %>
                                            <br><i class="bi bi-building"></i> Gym Review
                                        <% } %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center">
                    <p class="text-light">No reviews yet. Be the first to share your experience!</p>
                </div>
            <% } %>
        </div>
        
        <!-- Add Review Button -->
        <% if (user && user.role === 'client') { %>
        <div class="text-center mt-5">
            <button class="btn btn-warning btn-lg" data-bs-toggle="modal" data-bs-target="#reviewModal">
                <i class="bi bi-star-fill"></i> WRITE A REVIEW
            </button>
        </div>
        <% } %>
    </div>
</section>

<!-- Review Modal -->
<% if (user && user.role === 'client') { %>
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="reviewModalLabel">
                    <i class="bi bi-star-fill text-warning"></i> Write Your Review
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="reviewForm">
                    <div class="mb-3">
                        <label class="form-label">Review Type</label>
                        <select class="form-select" id="reviewType" required>
                            <option value="">Select review type</option>
                            <option value="gym">🏋️ Gym Review</option>
                            <option value="trainer">👨‍🏫 Trainer Review</option>
                        </select>
                    </div>
                    
                    <div class="mb-3" id="trainerSelectDiv" class="trainer-select-hidden">
                        <label class="form-label">Select Trainer</label>
                        <select class="form-select" id="trainerSelect">
                            <option value="">Choose a trainer</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <div class="rating-stars">
                            <input type="radio" id="star5" name="rating" value="5">
                            <label for="star5" class="star-label">★</label>
                            <input type="radio" id="star4" name="rating" value="4">
                            <label for="star4" class="star-label">★</label>
                            <input type="radio" id="star3" name="rating" value="3">
                            <label for="star3" class="star-label">★</label>
                            <input type="radio" id="star2" name="rating" value="2">
                            <label for="star2" class="star-label">★</label>
                            <input type="radio" id="star1" name="rating" value="1">
                            <label for="star1" class="star-label">★</label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="reviewTitle" class="form-label">Title</label>
                        <input type="text" class="form-control" id="reviewTitle" placeholder="Give your review a title" maxlength="100" required>
                        <small class="text-muted">3-100 characters</small>
                    </div>
                    
                    <div class="mb-3">
                        <label for="reviewComment" class="form-label">Your Review</label>
                        <textarea class="form-control" id="reviewComment" rows="4" placeholder="Share your experience..." maxlength="500" required></textarea>
                        <small class="text-muted">10-500 characters</small>
                    </div>
                    
                    <div id="reviewError" class="alert alert-danger d-none" role="alert"></div>
                    <div id="reviewSuccess" class="alert alert-success d-none" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="submitReview">
                    <i class="bi bi-send"></i> Submit Review
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

 <% if (!user) { %>
<%- include('partials/cta') %>
<% } %>
<%- include('partials/footer') %>